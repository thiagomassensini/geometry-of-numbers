material_theta_integral_input : ∀ (n : ℕ),
  (momentInputBox n).Mem (CarrySelfAdjointOperator.completedNativeThetaTailMoment (2 * n))
material_fourth_pivot_bounds_integral : 16 / 10 ^ 27 < GeometryOfNumbers.Analysis.carryMaterialFourthPivot ∧
  GeometryOfNumbers.Analysis.carryMaterialFourthPivot < 17 / 10 ^ 27
material_fourth_pivot_pos_integral : 0 < GeometryOfNumbers.Analysis.carryMaterialFourthPivot
material_fourth_block_posDef_integral : Matrix.PosDef fun i j =>
  GeometryOfNumbers.Analysis.carryMaterialEvenPairing ↑i ↑j
material_fourth_theta_integral_gate : -4 * ↑(Nat.factorial 18) *
    CarryMaterialFourthPivotComparison.material_fourth_characteristic_ceiling <
  ∫ (u : ℝ) in Set.Ioi 0, (1224 * u ^ 16 - u ^ 18) * CarrySelfAdjointOperator.XiThetaCosine.thetaTail u
material_fourth_cholesky_integral : GeometryOfNumbers.Analysis.carryMaterialEvenCholesky 4 *
    (GeometryOfNumbers.Analysis.carryMaterialEvenCholesky 4).transpose =
  fun i j => GeometryOfNumbers.Analysis.carryMaterialEvenPairing ↑i ↑j
