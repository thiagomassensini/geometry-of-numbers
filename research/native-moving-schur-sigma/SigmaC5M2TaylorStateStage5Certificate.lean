theorem c5M2Stage5PowerCoarsenExport :
    (c5M2Stage4PowerReExport.mul c5M2TaylorArgExport.re).coarsen 896 =
      c5M2Stage5PowerReExport := by
  have hleft : 0 ≤ c5M2Stage4PowerReExport.lo := by
    change 0 ≤ ((23818148471797878372032681346974626551037992263565854314490764464301515904862237744067247385063955454584447443449041347344105278218840073325327356729504726213559829982599606934547878577459061640116050243181041392268283368658255808819021836967889635005047858416763 : ℚ) / 264147265567832623176169892458258303259423663018060761063980354513336951278362429737208627943828593947337197496628564339441173779751342768625269489231469788454193341999502542084365758838213220526512116454105594202074014146375780869419198449383518238244769290448868999168)
    exact div_nonneg (by norm_num) (by positivity)
  have hright : c5M2TaylorArgExport.re.hi ≤ 0 := by
    change (-366185864761924607633321253586498369660149866159827963437501462880295197192391738261425226247908029624607428576434968385495774984256670761040581765262498167448455018821582024034576804740608033713796225879212579756766463759843857495596808398822993938612378660718589787915 : ℚ) /
      ((40 : ℚ) * (2 : ℚ) ^ 896) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  rw [c5IntervalMulNonnegNonpos _ _ hleft hright]
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage4PowerReExport, c5M2TaylorArgExport,
        c5M2Stage5PowerReExport, pow_succ]
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage4PowerReExport, c5M2TaylorArgExport,
        c5M2Stage5PowerReExport, pow_succ]

theorem c5M2Stage5PowerCorrect :
    (c5M2Stage4.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage5.1 := by
  have hm := c5ComplexRealMul c5M2Stage4PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage4PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage5.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage5PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage5TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 24) c5M2Stage4.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage5TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 24)) c5M2Stage4PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 24) c5M2Stage4.1 =
        { re := (Interval.exact (1 / 24)).mul c5M2Stage4PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 24), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage4PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 24) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage4PowerReExport,
          c5M2Stage5TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

theorem c5M2Stage5SumCorrect :
    (c5M2Stage4.2.add
      ((ComplexInterval.smulQ (1 / (Nat.factorial 4 : ℚ)) c5M2Stage4.1).coarsen 896)).coarsen 896 =
      c5M2Stage5.2 := by
  have hcoef : (1 / (Nat.factorial 4 : ℚ)) = 1 / 24 := by norm_num
  rw [hcoef, c5M2Stage5TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage4, c5M2Stage4SumReExport, c5M2Stage5,
          c5M2Stage5SumReExport, c5M2Stage5TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage4, c5M2Stage4SumReExport, c5M2Stage5,
          c5M2Stage5SumReExport, c5M2Stage5TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]

