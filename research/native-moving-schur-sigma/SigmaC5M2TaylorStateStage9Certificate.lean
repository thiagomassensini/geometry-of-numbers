theorem c5M2Stage9PowerCorrect :
    (c5M2Stage8.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage9.1 := by
  have hm := c5ComplexRealMul c5M2Stage8PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage8PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage9.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage9PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage9TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 40320) c5M2Stage8.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage9TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 40320)) c5M2Stage8PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 40320) c5M2Stage8.1 =
        { re := (Interval.exact (1 / 40320)).mul c5M2Stage8PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 40320), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage8PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 40320) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage8PowerReExport,
          c5M2Stage9TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

