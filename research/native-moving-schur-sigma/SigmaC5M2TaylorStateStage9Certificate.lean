  have hcoef : (1 / (Nat.factorial 8 : ℚ)) = 1 / 40320 := by norm_num
  rw [hcoef, c5M2Stage9TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
