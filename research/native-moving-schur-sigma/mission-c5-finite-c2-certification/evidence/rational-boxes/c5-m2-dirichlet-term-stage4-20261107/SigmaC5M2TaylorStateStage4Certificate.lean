theorem c5M2Stage4PowerCoarsenExport :
    (c5M2Stage3PowerReExport.mul c5M2TaylorArgExport.re).coarsen 896 =
      c5M2Stage4PowerReExport := by
  have hleft : c5M2Stage3PowerReExport.hi ≤ 0 := by
    change (-1374492987336793657293953958436886189450971700401985156261861814846326588614839784842853308890840366795779027136896630363294572246912851318885760862120508232662807653061487146529107229061407490693866201308477318618475914394024455996281310102487618871538706950044719 : ℚ) /
      264147265567832623176169892458258303259423663018060761063980354513336951278362429737208627943828593947337197496628564339441173779751342768625269489231469788454193341999502542084365758838213220526512116454105594202074014146375780869419198449383518238244769290448868999168 ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  have hright : c5M2TaylorArgExport.re.hi ≤ 0 := by
    change (-366185864761924607633321253586498369660149866159827963437501462880295197192391738261425226247908029624607428576434968385495774984256670761040581765262498167448455018821582024034576804740608033713796225879212579756766463759843857495596808398822993938612378660718589787915 : ℚ) /
      ((40 : ℚ) * (2 : ℚ) ^ 896) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  rw [c5IntervalMulNonpos _ _ hleft hright]
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage3PowerReExport, c5M2TaylorArgExport,
        c5M2Stage4PowerReExport, pow_succ]
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage3PowerReExport, c5M2TaylorArgExport,
        c5M2Stage4PowerReExport, pow_succ]

theorem c5M2Stage4PowerCorrect :
    (c5M2Stage3.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage4.1 := by
  have hm := c5ComplexRealMul c5M2Stage3PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage3PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage4.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage4PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage4TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 6) c5M2Stage3.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage4TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 6)) c5M2Stage3PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 6) c5M2Stage3.1 =
        { re := (Interval.exact (1 / 6)).mul c5M2Stage3PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 6), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage3PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 6) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage3PowerReExport,
          c5M2Stage4TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

theorem c5M2Stage4SumCorrect :
    (c5M2Stage3.2.add
      ((ComplexInterval.smulQ (1 / (Nat.factorial 3 : ℚ)) c5M2Stage3.1).coarsen 896)).coarsen 896 =
      c5M2Stage4.2 := by
  have hcoef : (1 / (Nat.factorial 3 : ℚ)) = 1 / 6 := by norm_num
  rw [hcoef, c5M2Stage4TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage3, c5M2Stage3SumReExport, c5M2Stage4,
          c5M2Stage4SumReExport, c5M2Stage4TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage3, c5M2Stage3SumReExport, c5M2Stage4,
          c5M2Stage4SumReExport, c5M2Stage4TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]

