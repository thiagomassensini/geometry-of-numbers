theorem c5M2Stage6PowerCoarsenExport :
    (c5M2Stage5PowerReExport.mul c5M2TaylorArgExport.re).coarsen 896 =
      c5M2Stage6PowerReExport := by
  have hleft : c5M2Stage5PowerReExport.hi ≤ 0 := by
    change ((-825474122969243471967194067508018782075982336068051558600242314387100446096096177205460443379898159156148458385295636468908732151420798171741861704232323903336792882945079383350361290464903559920546477513383990917787100659859016117960866965243949320730093573687 : ℚ) / 528294531135665246352339784916516606518847326036121522127960709026673902556724859474417255887657187894674394993257128678882347559502685537250538978462939576908386683999005084168731517676426441053024232908211188404148028292751561738838396898767036476489538580897737998336) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  have hright : c5M2TaylorArgExport.re.hi ≤ 0 := by
    change (-366185864761924607633321253586498369660149866159827963437501462880295197192391738261425226247908029624607428576434968385495774984256670761040581765262498167448455018821582024034576804740608033713796225879212579756766463759843857495596808398822993938612378660718589787915 : ℚ) /
      ((40 : ℚ) * (2 : ℚ) ^ 896) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  rw [c5IntervalMulNonpos _ _ hleft hright]
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage5PowerReExport, c5M2TaylorArgExport,
        c5M2Stage6PowerReExport, pow_succ]
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage5PowerReExport, c5M2TaylorArgExport,
        c5M2Stage6PowerReExport, pow_succ]

theorem c5M2Stage6PowerCorrect :
    (c5M2Stage5.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage6.1 := by
  have hm := c5ComplexRealMul c5M2Stage5PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage5PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage6.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage6PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage6TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 120) c5M2Stage5.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage6TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 120)) c5M2Stage5PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 120) c5M2Stage5.1 =
        { re := (Interval.exact (1 / 120)).mul c5M2Stage5PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 120), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage5PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 120) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage5PowerReExport,
          c5M2Stage6TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

theorem c5M2Stage6SumCorrect :
    (c5M2Stage5.2.add
      ((ComplexInterval.smulQ (1 / (Nat.factorial 5 : ℚ)) c5M2Stage5.1).coarsen 896)).coarsen 896 =
      c5M2Stage6.2 := by
  have hcoef : (1 / (Nat.factorial 5 : ℚ)) = 1 / 120 := by norm_num
  rw [hcoef, c5M2Stage6TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage5, c5M2Stage5SumReExport, c5M2Stage6,
          c5M2Stage6SumReExport, c5M2Stage6TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage5, c5M2Stage5SumReExport, c5M2Stage6,
          c5M2Stage6SumReExport, c5M2Stage6TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]

