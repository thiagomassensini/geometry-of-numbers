import SigmaC5M2TaylorStateStage18Certificate
import Mathlib.Tactic

open CarrySigmaObstruction ZetaLean ZetaLean.ComplexInterval

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

def c5M2Stage19PowerReExport : Interval :=
  Interval.mk ((-) : ℚ) ((-) : ℚ) (by norm_num)

def c5M2Stage19TermReExport : Interval :=
  Interval.mk (() : ℚ) (() : ℚ) (by norm_num)

def c5M2Stage19SumReExport : Interval :=
  Interval.mk (() : ℚ) (() : ℚ) (by norm_num)

def c5M2Stage19 : ComplexInterval × ComplexInterval :=
  (ComplexInterval.mk c5M2Stage19PowerReExport (Interval.exact 0),
    ComplexInterval.mk c5M2Stage19SumReExport (Interval.exact 0))

theorem c5M2Stage19PowerCoarsenExport :
    (c5M2Stage18PowerReExport.mul c5M2TaylorArgExport.re).coarsen 896 =
      c5M2Stage19PowerReExport := by
  have hleft : 0 ≤ c5M2Stage18PowerReExport.lo := by
    norm_num [c5M2Stage18PowerReExport]
  have hright : c5M2TaylorArgExport.re.hi ≤ 0 := by
    change (-366185864761924607633321253586498369660149866159827963437501462880295197192391738261425226247908029624607428576434968385495774984256670761040581765262498167448455018821582024034576804740608033713796225879212579756766463759843857495596808398822993938612378660718589787915 : ℚ) /
      ((40 : ℚ) * (2 : ℚ) ^ 896) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  rw [c5IntervalMulNonnegNonpos _ _ hleft hright]
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage18PowerReExport, c5M2TaylorArgExport,
        c5M2Stage19PowerReExport, pow_succ]
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage18PowerReExport, c5M2TaylorArgExport,
        c5M2Stage19PowerReExport, pow_succ]

theorem c5M2Stage19PowerCorrect :
    (c5M2Stage18.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage19.1 := by
  have hm := c5ComplexRealMul c5M2Stage18PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage18PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage19.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage19PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage19TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 6402373705728000) c5M2Stage18.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage19TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 6402373705728000)) c5M2Stage18PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 6402373705728000) c5M2Stage18.1 =
        { re := (Interval.exact (1 / 6402373705728000)).mul c5M2Stage18PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 6402373705728000), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage18PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 6402373705728000) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage18PowerReExport,
          c5M2Stage19TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

theorem c5M2Stage19SumCorrect :
    (c5M2Stage18.2.add
      ((ComplexInterval.smulQ (1 / (Nat.factorial 18 : ℚ)) c5M2Stage18.1).coarsen 896)).coarsen 896 =
      c5M2Stage19.2 := by
  have hcoef : (1 / (Nat.factorial 18 : ℚ)) = 1 / 6402373705728000 := by norm_num
  rw [hcoef, c5M2Stage19TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage18, c5M2Stage18SumReExport, c5M2Stage19,
          c5M2Stage19SumReExport, c5M2Stage19TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage18, c5M2Stage18SumReExport, c5M2Stage19,
          c5M2Stage19SumReExport, c5M2Stage19TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]

theorem c5RoundedExpStateC_stage19_correct :
    c5RoundedExpStateC 896 c5M2TaylorArgExport 19 = c5M2Stage19 := by
  rw [c5RoundedExpStateC_succ_eq, c5RoundedExpStateC_stage18_correct]
  apply Prod.ext
  · exact c5M2Stage19PowerCorrect
  · exact c5M2Stage19SumCorrect

