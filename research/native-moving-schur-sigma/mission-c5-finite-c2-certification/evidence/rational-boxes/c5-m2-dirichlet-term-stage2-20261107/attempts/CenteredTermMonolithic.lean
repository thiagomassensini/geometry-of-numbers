theorem c5CenteredLogQ_two_eq_logTwo (nLog : ℕ) :
    c5CenteredLogQ nLog (c5CenteredLogScale 2) (2 : ℚ) =
      c5CenteredLog2I nLog := by
  unfold c5CenteredLogQ c5CenteredLogQFromLogTwo
  have hk : c5CenteredLogScale 2 = 1 := by norm_num [c5CenteredLogScale]
  rw [hk]
  simp [c5CenteredFastLog1_one_eq_zero, Interval.exact, Interval.mul,
    Interval.add]

#print axioms c5CenteredLogQ_two_eq_logTwo

theorem c5M2CenteredTermBox_eq_export :
    c5CenteredDirichletTermBox 512 192 896 4 2
      (ComplexInterval.exact (2 / 5) 0) = c5M2CenteredTermExport := by
  change c5RoundedExpC 192 896 4
    ((ComplexInterval.exact (2 / 5) 0).neg.mul
      { re := (c5CenteredLogQ 512 (c5CenteredLogScale 2) 2).coarsen 896,
        im := Interval.exact 0 }) = c5M2CenteredTermExport
  rw [c5CenteredLogQ_two_eq_logTwo, c5CenteredLog2I_512_eq_export]
  norm_num [c5RoundedExpC, c5RoundedExpSmall, c5RoundedExpSumC,
    c5RoundedExpStateC, ComplexInterval.exact, ComplexInterval.halveC,
    ComplexInterval.neg, ComplexInterval.mul, ComplexInterval.add,
    ComplexInterval.coarsen, Interval.exact, Interval.coarsen,
    Interval.mul, Interval.add, Interval.sub, Interval.neg]

#print axioms c5M2CenteredTermBox_eq_export
