theorem c5M2Stage10PowerCorrect :
    (c5M2Stage9.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage10.1 := by
  have hm := c5ComplexRealMul c5M2Stage9PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage9PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage10.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage10PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage10TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 362880) c5M2Stage9.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage10TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 362880)) c5M2Stage9PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 362880) c5M2Stage9.1 =
        { re := (Interval.exact (1 / 362880)).mul c5M2Stage9PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 362880), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage9PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 362880) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage9PowerReExport,
          c5M2Stage10TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

theorem c5M2Stage10SumCorrect :
    (c5M2Stage9.2.add
      ((ComplexInterval.smulQ (1 / (Nat.factorial 9 : ℚ)) c5M2Stage9.1).coarsen 896)).coarsen 896 =
      c5M2Stage10.2 := by
  have hcoef : (1 / (Nat.factorial 9 : ℚ)) = 1 / 362880 := by norm_num
  rw [hcoef, c5M2Stage10TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage9, c5M2Stage9SumReExport, c5M2Stage10,
          c5M2Stage10SumReExport, c5M2Stage10TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage9, c5M2Stage9SumReExport, c5M2Stage10,
          c5M2Stage10SumReExport, c5M2Stage10TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]

