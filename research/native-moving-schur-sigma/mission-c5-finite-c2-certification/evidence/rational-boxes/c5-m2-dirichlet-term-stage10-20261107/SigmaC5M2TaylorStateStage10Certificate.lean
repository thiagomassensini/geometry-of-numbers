  rw [c5IntervalMulNonpos _ _ hleft hright]
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage9PowerReExport, c5M2TaylorArgExport,
        c5M2Stage10PowerReExport, pow_succ]
  · norm_num (config := { maxSteps := 1000000 })
