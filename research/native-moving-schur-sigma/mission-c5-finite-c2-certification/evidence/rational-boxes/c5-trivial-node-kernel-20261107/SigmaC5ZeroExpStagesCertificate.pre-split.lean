theorem c5ZeroExpStage0_eq :
    c5RoundedExpSmall 192 896 (ComplexInterval.exact 0 0) =
      c5ZeroExpStage0Export := by
  have hs : c5RoundedExpStateC 896 (ComplexInterval.exact 0 0) 192 =
      (ComplexInterval.exact 0 0, ComplexInterval.exact 1 0) := by
    simpa using c5ZeroExpStateSucc 896 191
  simp only [c5RoundedExpSmall, c5RoundedExpSumC, hs]
  norm_num [ComplexInterval.exact, ComplexInterval.inflate, Interval.exact, Nat.factorial, c5ZeroExpStage0Export]

theorem c5ZeroExpStage1_eq :
    c5RoundedExpC 192 896 1 (ComplexInterval.exact 0 0) =
      c5ZeroExpStage1Export := by
  have hhalf : ComplexInterval.halveC (ComplexInterval.exact 0 0) =
      ComplexInterval.exact 0 0 := by
    simp [ComplexInterval.halveC, ComplexInterval.exact, Interval.exact,
      Interval.halve]
  have hy : c5RoundedExpC 192 896 0
      (ComplexInterval.halveC (ComplexInterval.exact 0 0)) =
      c5ZeroExpStage0Export := by
    rw [hhalf]
    simpa [c5RoundedExpC] using c5ZeroExpStage0_eq
  change ((c5RoundedExpC 192 896 0
      (ComplexInterval.halveC (ComplexInterval.exact 0 0))).mul
      (c5RoundedExpC 192 896 0
        (ComplexInterval.halveC (ComplexInterval.exact 0 0)))).coarsen 896 =
      c5ZeroExpStage1Export
  rw [hy]
  norm_num [ComplexInterval.exact, ComplexInterval.mul,
    ComplexInterval.coarsen, Interval.exact, Interval.mul,
    Interval.sub, Interval.neg, Interval.coarsen,
    c5ZeroExpStage0Export, c5ZeroExpStage1Export]
  all_goals field_simp <;> norm_num [Rat.floor_def', Rat.ceil_def']


#print axioms c5ZeroExpStage0_eq
#print axioms c5ZeroExpStage1_eq
