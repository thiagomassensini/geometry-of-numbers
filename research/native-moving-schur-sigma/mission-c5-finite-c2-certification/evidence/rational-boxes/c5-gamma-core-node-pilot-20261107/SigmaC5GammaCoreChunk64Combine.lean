import SigmaC5GammaCoreChunk64Certificate
import Mathlib.Tactic

open SigmaC5Gamma
open scoped BigOperators

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

private def c5GammaCoreTermReal (k : ℕ) : ℚ :=
  (ratGammaTerm 240 (1 / 5) 0 k).1

private def c5GammaCoreChunkFloor (i : ℕ) : ℤ :=
  Int.floor (c5GammaCoreChunk64 i)

private theorem c5GammaCoreSumRangeBlocks (f : ℕ → ℚ) (n : ℕ) :
    (∑ k ∈ Finset.range (64 * n), f k) =
      ∑ i ∈ Finset.range n, ∑ j ∈ Finset.range 64, f (64 * i + j) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Nat.mul_succ, Finset.sum_range_add, ih]
      simp only [Finset.sum_range_succ]

theorem c5GammaCoreNodePilotScaled_eq_chunkSum :
    c5GammaCoreNodePilotScaled =
      ∑ i ∈ Finset.range 16, c5GammaCoreChunk64 i := by
  change
    (∑ k ∈ Finset.range 1024, (ratGammaTerm 240 (1 / 5) 0 k).1) *
      (2 : ℚ) ^ 1024 =
    ∑ i ∈ Finset.range 16,
      ((∑ j ∈ Finset.range 64,
          (ratGammaTerm 240 (1 / 5) 0 (64 * i + j)).1) * (2 : ℚ) ^ 1024)
  have h1024 : 1024 = 64 * 16 := by norm_num
  calc
    _ = (∑ k ∈ Finset.range (64 * 16),
        (ratGammaTerm 240 (1 / 5) 0 k).1) * (2 : ℚ) ^ 1024 := by rw [h1024]
    _ = (∑ i ∈ Finset.range 16, ∑ j ∈ Finset.range 64,
        (ratGammaTerm 240 (1 / 5) 0 (64 * i + j)).1) * (2 : ℚ) ^ 1024 := by
          congr 1
          exact c5GammaCoreSumRangeBlocks
            (fun k => (ratGammaTerm 240 (1 / 5) 0 k).1) 16
    _ = ∑ i ∈ Finset.range 16,
        ((∑ j ∈ Finset.range 64,
          (ratGammaTerm 240 (1 / 5) 0 (64 * i + j)).1) * (2 : ℚ) ^ 1024) := by
          rw [Finset.sum_mul]

theorem c5GammaCoreNodePilotScaled_chunkBounds :
    (∑ i ∈ Finset.range 16, (c5GammaCoreChunkFloor i : ℚ)) ≤
      c5GammaCoreNodePilotScaled ∧
    c5GammaCoreNodePilotScaled <
      ∑ i ∈ Finset.range 16, ((c5GammaCoreChunkFloor i : ℚ) + 1) := by
  rw [c5GammaCoreNodePilotScaled_eq_chunkSum]
  constructor
  · apply Finset.sum_le_sum
    intro i hi
    exact_mod_cast Int.floor_le (c5GammaCoreChunk64 i)
  · apply Finset.sum_lt_sum
    · intro i hi
      exact_mod_cast (Int.lt_floor_add_one (c5GammaCoreChunk64 i)).le
    · exact ⟨0, by simp, by exact_mod_cast Int.lt_floor_add_one (c5GammaCoreChunk64 0)⟩

#print axioms c5GammaCoreNodePilotScaled_eq_chunkSum
#print axioms c5GammaCoreNodePilotScaled_chunkBounds


theorem c5GammaCoreChunkFloorSum_eq :
    (∑ i ∈ Finset.range 16, (c5GammaCoreChunkFloor i : ℚ)) = ( : ℚ) := by
  norm_num [c5GammaCoreChunkFloor, c5GammaChunk64_0_floor,
    c5GammaChunk64_1_floor,
    c5GammaChunk64_2_floor,
    c5GammaChunk64_3_floor,
    c5GammaChunk64_4_floor,
    c5GammaChunk64_5_floor,
    c5GammaChunk64_6_floor,
    c5GammaChunk64_7_floor,
    c5GammaChunk64_8_floor,
    c5GammaChunk64_9_floor,
    c5GammaChunk64_10_floor,
    c5GammaChunk64_11_floor,
    c5GammaChunk64_12_floor,
    c5GammaChunk64_13_floor,
    c5GammaChunk64_14_floor,
    c5GammaChunk64_15_floor, Finset.sum_range_succ]


def c5GammaCoreNodePilotChunkBox : ZetaLean.ComplexInterval :=
  { re := { lo := ( : ℚ) / (2 : ℚ) ^ 1024,
            hi := ( : ℚ) / (2 : ℚ) ^ 1024,
            le := by
              have hnum : ( : ℚ) ≤ ( : ℚ) := by norm_num
              exact div_le_div_of_nonneg_right hnum (by positivity) },
    im := ZetaLean.Interval.exact 0 }

theorem c5GammaCoreNodePilotChunkBox_contains :
    c5GammaCoreNodePilotChunkBox.contains
      (ratComplexToComplex c5GammaCoreNodePilot) := by
  have hbounds := c5GammaCoreNodePilotScaled_chunkBounds
  have hlo : ( : ℚ) ≤ c5GammaCoreNodePilotScaled := by
    simpa [c5GammaCoreChunkFloorSum_eq] using hbounds.1
  have hhi : c5GammaCoreNodePilotScaled < ( : ℚ) := by
    calc
      c5GammaCoreNodePilotScaled <
          ∑ i ∈ Finset.range 16, ((c5GammaCoreChunkFloor i : ℚ) + 1) := hbounds.2
      _ = ( : ℚ) + 16 := by
        rw [Finset.sum_add_distrib, c5GammaCoreChunkFloorSum_eq]
        norm_num
      _ = ( : ℚ) := by norm_num
  have hden : (0 : ℚ) < (2 : ℚ) ^ 1024 := by positivity
  have hqlo : ( : ℚ) / (2 : ℚ) ^ 1024 ≤ c5GammaCoreNodePilot.1 := by
    rw [div_le_iff₀ hden]
    simpa [c5GammaCoreNodePilotScaled] using hlo
  have hqhi : c5GammaCoreNodePilot.1 ≤ ( : ℚ) / (2 : ℚ) ^ 1024 := by
    rw [le_div_iff₀ hden]
    have hh : c5GammaCoreNodePilot.1 * (2 : ℚ) ^ 1024 < ( : ℚ) := by
      simpa [c5GammaCoreNodePilotScaled] using hhi
    exact le_of_lt hh
  have him : c5GammaCoreNodePilot.2 = 0 := by
    change (∑ k ∈ Finset.range 1024, (ratGammaTerm 240 (1 / 5) 0 k).2) = 0
    apply Finset.sum_eq_zero
    intro k hk
    simp [ratGammaTerm, ratComplexInv, ratComplexMul]
  simp only [ZetaLean.ComplexInterval.contains, ZetaLean.Interval.contains,
    c5GammaCoreNodePilotChunkBox, ZetaLean.Interval.exact, ratComplexToComplex]
  constructor
  · constructor
    · exact_mod_cast hqlo
    · exact_mod_cast hqhi
  · simp [him]

#print axioms c5GammaCoreChunkFloorSum_eq
#print axioms c5GammaCoreNodePilotChunkBox_contains
