theorem c5M2Stage12PowerCoarsenExport :
    (c5M2Stage11PowerReExport.mul c5M2TaylorArgExport.re).coarsen 896 =
      c5M2Stage12PowerReExport := by
  have hleft : c5M2Stage11PowerReExport.hi ≤ 0 := by
    norm_num [c5M2Stage11PowerReExport]
  have hright : c5M2TaylorArgExport.re.hi ≤ 0 := by
    change (-366185864761924607633321253586498369660149866159827963437501462880295197192391738261425226247908029624607428576434968385495774984256670761040581765262498167448455018821582024034576804740608033713796225879212579756766463759843857495596808398822993938612378660718589787915 : ℚ) /
      ((40 : ℚ) * (2 : ℚ) ^ 896) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  rw [c5IntervalMulNonpos _ _ hleft hright]
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage11PowerReExport, c5M2TaylorArgExport,
        c5M2Stage12PowerReExport, pow_succ]
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage11PowerReExport, c5M2TaylorArgExport,
        c5M2Stage12PowerReExport, pow_succ]

theorem c5M2Stage12PowerCorrect :
    (c5M2Stage11.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage12.1 := by
  have hm := c5ComplexRealMul c5M2Stage11PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage11PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage12.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage12PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage12TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 39916800) c5M2Stage11.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage12TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 39916800)) c5M2Stage11PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 39916800) c5M2Stage11.1 =
        { re := (Interval.exact (1 / 39916800)).mul c5M2Stage11PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 39916800), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage11PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 39916800) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage11PowerReExport,
          c5M2Stage12TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

theorem c5M2Stage12SumCorrect :
    (c5M2Stage11.2.add
      ((ComplexInterval.smulQ (1 / (Nat.factorial 11 : ℚ)) c5M2Stage11.1).coarsen 896)).coarsen 896 =
      c5M2Stage12.2 := by
  have hcoef : (1 / (Nat.factorial 11 : ℚ)) = 1 / 39916800 := by norm_num
  rw [hcoef, c5M2Stage12TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage11, c5M2Stage11SumReExport, c5M2Stage12,
          c5M2Stage12SumReExport, c5M2Stage12TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage11, c5M2Stage11SumReExport, c5M2Stage12,
          c5M2Stage12SumReExport, c5M2Stage12TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]

