def c5ExportedLogTwo512 : Interval :=
  { lo := (( : ℚ) / ), hi := (( : ℚ) / ), le := by norm_num }

theorem c5Interval_ext {x y : Interval} (hlo : x.lo = y.lo) (hhi : x.hi = y.hi) :
    x = y := by
  cases x
  cases y
  simp_all

theorem c5CenteredLog2I_512_eq_export :
    c5CenteredLog2I 512 = c5ExportedLogTwo512 := by
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [c5CenteredLog2I, Interval.log1, Interval.exact, Interval.neg,
       Interval.add, Interval.logRem, pow_succ, c5ExportedLogTwo512,
       c5LogSum512_pos_eq, c5LogSum512_neg_eq]
  · norm_num (config := { maxSteps := 1000000 })
      [c5CenteredLog2I, Interval.log1, Interval.exact, Interval.neg,
       Interval.add, Interval.logRem, pow_succ, c5ExportedLogTwo512,
       c5LogSum512_pos_eq, c5LogSum512_neg_eq]

