def c5LogBlock32 (q : ℚ) (k : ℕ) : ℚ :=
  ∑ i ∈ Finset.range 32, q ^ (32 * k + i + 1) / (32 * k + i + 1)

theorem c5SumRangeMulBlocks (f : ℕ → ℚ) (m n : ℕ) :
    (∑ i ∈ Finset.range (m * n), f i) =
      ∑ k ∈ Finset.range m, ∑ i ∈ Finset.range n, f (n * k + i) := by
  induction m with
  | zero => simp
  | succ m ih =>
      rw [Nat.succ_mul, Finset.sum_range_add, ih, Finset.sum_range_succ]
      simp only [Nat.mul_comm]

theorem c5LogSum512_blocks (q : ℚ) :
    Interval.logSum 512 q =
      ∑ k ∈ Finset.range 16, c5LogBlock32 q k := by
  unfold Interval.logSum
  rw [show (512 : ℕ) = 16 * 32 by norm_num, c5SumRangeMulBlocks]
  simp [c5LogBlock32, Nat.cast_add]

