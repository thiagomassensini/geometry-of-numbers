    (c5M2Stage6PowerReExport.mul c5M2TaylorArgExport.re).coarsen 896 =
      c5M2Stage7PowerReExport := by
  have hleft : 0 ≤ c5M2Stage6PowerReExport.lo := by
    change 0 ≤ ((3576094131008279390808756083425633365301274455157091337082447473178004786037005609570968906614410859149112707531785745767915085816806435643207524811476992885901714654726189349595774056304108741780079850842037854386765603829514734059837284480797498248868305417 : ℚ) / 132073632783916311588084946229129151629711831509030380531990177256668475639181214868604313971914296973668598748314282169720586889875671384312634744615734894227096670999751271042182879419106610263256058227052797101037007073187890434709599224691759119122384645224434499584)
    exact div_nonneg (by norm_num) (by positivity)
  have hright : c5M2TaylorArgExport.re.hi ≤ 0 := by
    change (-366185864761924607633321253586498369660149866159827963437501462880295197192391738261425226247908029624607428576434968385495774984256670761040581765262498167448455018821582024034576804740608033713796225879212579756766463759843857495596808398822993938612378660718589787915 : ℚ) /
      ((40 : ℚ) * (2 : ℚ) ^ 896) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  rw [c5IntervalMulNonnegNonpos _ _ hleft hright]
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage6PowerReExport, c5M2TaylorArgExport,
        c5M2Stage7PowerReExport, pow_succ]
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage6PowerReExport, c5M2TaylorArgExport,
        c5M2Stage7PowerReExport, pow_succ]

theorem c5M2Stage7PowerCorrect :
    (c5M2Stage6.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage7.1 := by
  have hm := c5ComplexRealMul c5M2Stage6PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage6PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage7.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage7PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage7TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 720) c5M2Stage6.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage7TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 720)) c5M2Stage6PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 720) c5M2Stage6.1 =
        { re := (Interval.exact (1 / 720)).mul c5M2Stage6PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 720), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage6PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 720) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage6PowerReExport,
          c5M2Stage7TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

theorem c5M2Stage7SumCorrect :
    (c5M2Stage6.2.add
      ((ComplexInterval.smulQ (1 / (Nat.factorial 6 : ℚ)) c5M2Stage6.1).coarsen 896)).coarsen 896 =
      c5M2Stage7.2 := by
  have hcoef : (1 / (Nat.factorial 6 : ℚ)) = 1 / 720 := by norm_num
  rw [hcoef, c5M2Stage7TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage6, c5M2Stage6SumReExport, c5M2Stage7,
          c5M2Stage7SumReExport, c5M2Stage7TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage6, c5M2Stage6SumReExport, c5M2Stage7,
          c5M2Stage7SumReExport, c5M2Stage7TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]

