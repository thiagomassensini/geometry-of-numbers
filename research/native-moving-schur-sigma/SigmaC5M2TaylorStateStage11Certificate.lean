theorem c5M2Stage11PowerCorrect :
    (c5M2Stage10.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage11.1 := by
  have hm := c5ComplexRealMul c5M2Stage10PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage10PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage11.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage11PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage11TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 3628800) c5M2Stage10.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage11TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 3628800)) c5M2Stage10PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 3628800) c5M2Stage10.1 =
        { re := (Interval.exact (1 / 3628800)).mul c5M2Stage10PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 3628800), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage10PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 3628800) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage10PowerReExport,
          c5M2Stage11TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

