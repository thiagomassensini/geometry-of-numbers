  have hcoef : (1 / (Nat.factorial 10 : ℚ)) = 1 / 3628800 := by norm_num
  rw [hcoef, c5M2Stage11TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
