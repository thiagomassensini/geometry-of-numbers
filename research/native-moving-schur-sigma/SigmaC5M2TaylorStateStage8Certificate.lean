theorem c5M2Stage8PowerCoarsenExport :
    (c5M2Stage7PowerReExport.mul c5M2TaylorArgExport.re).coarsen 896 =
      c5M2Stage8PowerReExport := by
  have hleft : c5M2Stage7PowerReExport.hi ≤ 0 := by
    change ((-123937978216267827554189301219689100337996045827688411532766423183686362254914223943964713365258463743393473230894348004976445907038807588776359602951696854122615311887262984590097186279585188817246555636064700014698862623621669003628133113114075224338205915 : ℚ) / 264147265567832623176169892458258303259423663018060761063980354513336951278362429737208627943828593947337197496628564339441173779751342768625269489231469788454193341999502542084365758838213220526512116454105594202074014146375780869419198449383518238244769290448868999168) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  have hright : c5M2TaylorArgExport.re.hi ≤ 0 := by
    change (-366185864761924607633321253586498369660149866159827963437501462880295197192391738261425226247908029624607428576434968385495774984256670761040581765262498167448455018821582024034576804740608033713796225879212579756766463759843857495596808398822993938612378660718589787915 : ℚ) /
      ((40 : ℚ) * (2 : ℚ) ^ 896) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  rw [c5IntervalMulNonpos _ _ hleft hright]
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage7PowerReExport, c5M2TaylorArgExport,
        c5M2Stage8PowerReExport, pow_succ]
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage7PowerReExport, c5M2TaylorArgExport,
        c5M2Stage8PowerReExport, pow_succ]

theorem c5M2Stage8PowerCorrect :
    (c5M2Stage7.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage8.1 := by
  have hm := c5ComplexRealMul c5M2Stage7PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage7PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage8.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage8PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage8TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 5040) c5M2Stage7.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage8TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 5040)) c5M2Stage7PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 5040) c5M2Stage7.1 =
        { re := (Interval.exact (1 / 5040)).mul c5M2Stage7PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 5040), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage7PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 5040) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage7PowerReExport,
          c5M2Stage8TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

theorem c5M2Stage8SumCorrect :
    (c5M2Stage7.2.add
      ((ComplexInterval.smulQ (1 / (Nat.factorial 7 : ℚ)) c5M2Stage7.1).coarsen 896)).coarsen 896 =
      c5M2Stage8.2 := by
  have hcoef : (1 / (Nat.factorial 7 : ℚ)) = 1 / 5040 := by norm_num
  rw [hcoef, c5M2Stage8TermCoarsenExport]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage7, c5M2Stage7SumReExport, c5M2Stage8,
          c5M2Stage8SumReExport, c5M2Stage8TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.add, ComplexInterval.coarsen,
          c5M2Stage7, c5M2Stage7SumReExport, c5M2Stage8,
          c5M2Stage8SumReExport, c5M2Stage8TermReExport,
          Interval.add, Interval.coarsen, Interval.exact, pow_succ]

