theorem c5M2Stage14PowerCoarsenExport :
    (c5M2Stage13PowerReExport.mul c5M2TaylorArgExport.re).coarsen 896 =
      c5M2Stage14PowerReExport := by
  have hleft : c5M2Stage13PowerReExport.hi ≤ 0 := by
    norm_num [c5M2Stage13PowerReExport]
  have hright : c5M2TaylorArgExport.re.hi ≤ 0 := by
    change (-366185864761924607633321253586498369660149866159827963437501462880295197192391738261425226247908029624607428576434968385495774984256670761040581765262498167448455018821582024034576804740608033713796225879212579756766463759843857495596808398822993938612378660718589787915 : ℚ) /
      ((40 : ℚ) * (2 : ℚ) ^ 896) ≤ 0
    exact div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
  rw [c5IntervalMulNonpos _ _ hleft hright]
  apply c5Interval_ext
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage13PowerReExport, c5M2TaylorArgExport,
        c5M2Stage14PowerReExport, pow_succ]
  · norm_num (config := { maxSteps := 1000000 })
      [Interval.coarsen, c5M2Stage13PowerReExport, c5M2TaylorArgExport,
        c5M2Stage14PowerReExport, pow_succ]

theorem c5M2Stage14PowerCorrect :
    (c5M2Stage13.1.mul c5M2TaylorArgExport).coarsen 896 = c5M2Stage14.1 := by
  have hm := c5ComplexRealMul c5M2Stage13PowerReExport c5M2TaylorArgExport.re
  change
    (({ re := c5M2Stage13PowerReExport, im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2TaylorArgExport.re, im := Interval.exact 0 } : ComplexInterval)).coarsen 896 =
      c5M2Stage14.1
  rw [hm]
  apply c5ComplexInterval_ext
  · exact c5M2Stage14PowerCoarsenExport
  · exact c5M2CoarsenZero 896

theorem c5M2Stage14TermCoarsenExport :
    (ComplexInterval.smulQ (1 / 6227020800) c5M2Stage13.1).coarsen 896 =
      ComplexInterval.mk c5M2Stage14TermReExport (Interval.exact 0) := by
  have hm := c5ComplexRealMul (Interval.exact (1 / 6227020800)) c5M2Stage13PowerReExport
  have hscale :
      ComplexInterval.smulQ (1 / 6227020800) c5M2Stage13.1 =
        { re := (Interval.exact (1 / 6227020800)).mul c5M2Stage13PowerReExport,
          im := Interval.exact 0 } := by
    change ({ re := Interval.exact (1 / 6227020800), im := Interval.exact 0 } : ComplexInterval).mul
      ({ re := c5M2Stage13PowerReExport, im := Interval.exact 0 } : ComplexInterval) = _
    exact hm
  rw [hscale, c5IntervalExactNonnegMul (1 / 6227020800) (by norm_num)]
  apply c5ComplexInterval_ext
  · apply c5Interval_ext <;>
      norm_num (config := { maxSteps := 1000000 })
        [ComplexInterval.coarsen, c5M2Stage13PowerReExport,
          c5M2Stage14TermReExport, Interval.coarsen, pow_succ]
  · exact c5M2CoarsenZero 896

