import SigmaC5GammaComplexNodeCertificate
import Mathlib.Tactic

open SigmaC5Gamma ZetaLean ZetaLean.ComplexInterval
open scoped BigOperators

set_option maxHeartbeats 0
set_option maxRecDepth 1000000
set_option exponentiation.threshold 2048

def c5GammaComplexNodeCore : RatComplex :=
  gammaFiniteRationalCore 1024 240 (901 / 4000) (3 / 20)

def c5GammaComplexNodeCoreScaledReal : ℚ :=
  c5GammaComplexNodeCore.1 * (2 : ℚ) ^ 1024

def c5GammaComplexNodeCoreScaledImag : ℚ :=
  c5GammaComplexNodeCore.2 * (2 : ℚ) ^ 1024

def c5GammaComplexNodeRealFloor (i : ℕ) : ℤ :=
  Int.floor (c5GammaComplexNodeChunk64 i).1

def c5GammaComplexNodeImagFloor (i : ℕ) : ℤ :=
  Int.floor (c5GammaComplexNodeChunk64 i).2

private theorem c5GammaComplexNodeSumRangeBlocks (f : ℕ → ℚ) (n : ℕ) :
    (∑ k ∈ Finset.range (64 * n), f k) =
      ∑ i ∈ Finset.range n, ∑ j ∈ Finset.range 64, f (64 * i + j) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Nat.mul_succ, Finset.sum_range_add, ih]
      simp only [Finset.sum_range_succ]

theorem c5GammaComplexNodeCoreScaledReal_eq_chunkSum :
    c5GammaComplexNodeCoreScaledReal =
      ∑ i ∈ Finset.range 16, (c5GammaComplexNodeChunk64 i).1 := by
  change
    (∑ k ∈ Finset.range 1024,
      (ratGammaTerm 240 (901 / 4000) (3 / 20) k).1) * (2 : ℚ) ^ 1024 =
    ∑ i ∈ Finset.range 16,
      ((∑ j ∈ Finset.range 64,
        (ratGammaTerm 240 (901 / 4000) (3 / 20) (64 * i + j)).1) * (2 : ℚ) ^ 1024)
  have h1024 : 1024 = 64 * 16 := by norm_num
  calc
    _ = (∑ k ∈ Finset.range (64 * 16),
        (ratGammaTerm 240 (901 / 4000) (3 / 20) k).1) * (2 : ℚ) ^ 1024 := by rw [h1024]
    _ = (∑ i ∈ Finset.range 16, ∑ j ∈ Finset.range 64,
        (ratGammaTerm 240 (901 / 4000) (3 / 20) (64 * i + j)).1) * (2 : ℚ) ^ 1024 := by
          congr 1
          exact c5GammaComplexNodeSumRangeBlocks
            (fun k => (ratGammaTerm 240 (901 / 4000) (3 / 20) k).1) 16
    _ = ∑ i ∈ Finset.range 16,
        ((∑ j ∈ Finset.range 64,
          (ratGammaTerm 240 (901 / 4000) (3 / 20) (64 * i + j)).1) * (2 : ℚ) ^ 1024) := by
          rw [Finset.sum_mul]

theorem c5GammaComplexNodeCoreScaledImag_eq_chunkSum :
    c5GammaComplexNodeCoreScaledImag =
      ∑ i ∈ Finset.range 16, (c5GammaComplexNodeChunk64 i).2 := by
  change
    (∑ k ∈ Finset.range 1024,
      (ratGammaTerm 240 (901 / 4000) (3 / 20) k).2) * (2 : ℚ) ^ 1024 =
    ∑ i ∈ Finset.range 16,
      ((∑ j ∈ Finset.range 64,
        (ratGammaTerm 240 (901 / 4000) (3 / 20) (64 * i + j)).2) * (2 : ℚ) ^ 1024)
  have h1024 : 1024 = 64 * 16 := by norm_num
  calc
    _ = (∑ k ∈ Finset.range (64 * 16),
        (ratGammaTerm 240 (901 / 4000) (3 / 20) k).2) * (2 : ℚ) ^ 1024 := by rw [h1024]
    _ = (∑ i ∈ Finset.range 16, ∑ j ∈ Finset.range 64,
        (ratGammaTerm 240 (901 / 4000) (3 / 20) (64 * i + j)).2) * (2 : ℚ) ^ 1024 := by
          congr 1
          exact c5GammaComplexNodeSumRangeBlocks
            (fun k => (ratGammaTerm 240 (901 / 4000) (3 / 20) k).2) 16
    _ = ∑ i ∈ Finset.range 16,
        ((∑ j ∈ Finset.range 64,
          (ratGammaTerm 240 (901 / 4000) (3 / 20) (64 * i + j)).2) * (2 : ℚ) ^ 1024) := by
          rw [Finset.sum_mul]

theorem c5GammaComplexNodeCoreScaled_chunkBounds :
    (∑ i ∈ Finset.range 16, (c5GammaComplexNodeRealFloor i : ℚ)) ≤
      c5GammaComplexNodeCoreScaledReal ∧
    c5GammaComplexNodeCoreScaledReal <
      ∑ i ∈ Finset.range 16, ((c5GammaComplexNodeRealFloor i : ℚ) + 1) ∧
    (∑ i ∈ Finset.range 16, (c5GammaComplexNodeImagFloor i : ℚ)) ≤
      c5GammaComplexNodeCoreScaledImag ∧
    c5GammaComplexNodeCoreScaledImag <
      ∑ i ∈ Finset.range 16, ((c5GammaComplexNodeImagFloor i : ℚ) + 1) := by
  constructor
  · rw [c5GammaComplexNodeCoreScaledReal_eq_chunkSum]
    apply Finset.sum_le_sum
    intro i hi
    exact_mod_cast Int.floor_le (c5GammaComplexNodeChunk64 i).1
  constructor
  · rw [c5GammaComplexNodeCoreScaledReal_eq_chunkSum]
    apply Finset.sum_lt_sum
    · intro i hi
      exact_mod_cast (Int.lt_floor_add_one (c5GammaComplexNodeChunk64 i).1).le
    · exact ⟨0, by simp, by exact_mod_cast Int.lt_floor_add_one (c5GammaComplexNodeChunk64 0).1⟩
  constructor
  · rw [c5GammaComplexNodeCoreScaledImag_eq_chunkSum]
    apply Finset.sum_le_sum
    intro i hi
    exact_mod_cast Int.floor_le (c5GammaComplexNodeChunk64 i).2
  · rw [c5GammaComplexNodeCoreScaledImag_eq_chunkSum]
    apply Finset.sum_lt_sum
    · intro i hi
      exact_mod_cast (Int.lt_floor_add_one (c5GammaComplexNodeChunk64 i).2).le
    · exact ⟨0, by simp, by exact_mod_cast Int.lt_floor_add_one (c5GammaComplexNodeChunk64 0).2⟩

#print axioms c5GammaComplexNodeCoreScaledReal_eq_chunkSum
#print axioms c5GammaComplexNodeCoreScaledImag_eq_chunkSum
#print axioms c5GammaComplexNodeCoreScaled_chunkBounds

theorem c5GammaComplexNodeRealFloorSum_eq :
    (∑ i ∈ Finset.range 16, (c5GammaComplexNodeRealFloor i : ℚ)) = ( : ℚ) := by
  norm_num [c5GammaComplexNodeRealFloor,     c5GammaComplexNodeChunk64RealFloor_0,
    c5GammaComplexNodeChunk64RealFloor_1,
    c5GammaComplexNodeChunk64RealFloor_2,
    c5GammaComplexNodeChunk64RealFloor_3,
    c5GammaComplexNodeChunk64RealFloor_4,
    c5GammaComplexNodeChunk64RealFloor_5,
    c5GammaComplexNodeChunk64RealFloor_6,
    c5GammaComplexNodeChunk64RealFloor_7,
    c5GammaComplexNodeChunk64RealFloor_8,
    c5GammaComplexNodeChunk64RealFloor_9,
    c5GammaComplexNodeChunk64RealFloor_10,
    c5GammaComplexNodeChunk64RealFloor_11,
    c5GammaComplexNodeChunk64RealFloor_12,
    c5GammaComplexNodeChunk64RealFloor_13,
    c5GammaComplexNodeChunk64RealFloor_14,
    c5GammaComplexNodeChunk64RealFloor_15, Finset.sum_range_succ]

theorem c5GammaComplexNodeImagFloorSum_eq :
    (∑ i ∈ Finset.range 16, (c5GammaComplexNodeImagFloor i : ℚ)) = (- : ℚ) := by
  norm_num [c5GammaComplexNodeImagFloor,     c5GammaComplexNodeChunk64ImagFloor_0,
    c5GammaComplexNodeChunk64ImagFloor_1,
    c5GammaComplexNodeChunk64ImagFloor_2,
    c5GammaComplexNodeChunk64ImagFloor_3,
    c5GammaComplexNodeChunk64ImagFloor_4,
    c5GammaComplexNodeChunk64ImagFloor_5,
    c5GammaComplexNodeChunk64ImagFloor_6,
    c5GammaComplexNodeChunk64ImagFloor_7,
    c5GammaComplexNodeChunk64ImagFloor_8,
    c5GammaComplexNodeChunk64ImagFloor_9,
    c5GammaComplexNodeChunk64ImagFloor_10,
    c5GammaComplexNodeChunk64ImagFloor_11,
    c5GammaComplexNodeChunk64ImagFloor_12,
    c5GammaComplexNodeChunk64ImagFloor_13,
    c5GammaComplexNodeChunk64ImagFloor_14,
    c5GammaComplexNodeChunk64ImagFloor_15, Finset.sum_range_succ]

def c5GammaComplexNodeCoreBox : ZetaLean.ComplexInterval :=
  { re := { lo := ( : ℚ) / (2 : ℚ) ^ 1024,
            hi := (( + 16) : ℚ) / (2 : ℚ) ^ 1024,
            le := by
              have hnum : ( : ℚ) ≤
                  ( + 16 : ℚ) := by norm_num
              exact div_le_div_of_nonneg_right hnum (by positivity) },
    im := { lo := (- : ℚ) / (2 : ℚ) ^ 1024,
            hi := ((- + 16) : ℚ) / (2 : ℚ) ^ 1024,
            le := by
              have hnum : (- : ℚ) ≤
                  (- + 16 : ℚ) := by norm_num
              exact div_le_div_of_nonneg_right hnum (by positivity) } }

theorem c5GammaComplexNodeCoreBox_contains :
    c5GammaComplexNodeCoreBox.contains (ratComplexToComplex c5GammaComplexNodeCore) := by
  have hbounds := c5GammaComplexNodeCoreScaled_chunkBounds
  have hReLo : ( : ℚ) ≤ c5GammaComplexNodeCoreScaledReal := by
    simpa [c5GammaComplexNodeRealFloorSum_eq] using hbounds.1
  have hReHi : c5GammaComplexNodeCoreScaledReal < ( + 16 : ℚ) := by
    calc
      c5GammaComplexNodeCoreScaledReal <
          ∑ i ∈ Finset.range 16, ((c5GammaComplexNodeRealFloor i : ℚ) + 1) := hbounds.2.1
      _ = ( : ℚ) + 16 := by
        rw [Finset.sum_add_distrib, c5GammaComplexNodeRealFloorSum_eq]
        norm_num
  have hImLo : (- : ℚ) ≤ c5GammaComplexNodeCoreScaledImag := by
    simpa [c5GammaComplexNodeImagFloorSum_eq] using hbounds.2.2.1
  have hImHi : c5GammaComplexNodeCoreScaledImag < (- + 16 : ℚ) := by
    calc
      c5GammaComplexNodeCoreScaledImag <
          ∑ i ∈ Finset.range 16, ((c5GammaComplexNodeImagFloor i : ℚ) + 1) := hbounds.2.2.2
      _ = (- : ℚ) + 16 := by
        rw [Finset.sum_add_distrib, c5GammaComplexNodeImagFloorSum_eq]
        norm_num
  have hden : (0 : ℚ) < (2 : ℚ) ^ 1024 := by positivity
  have hqloRe : ( : ℚ) / (2 : ℚ) ^ 1024 ≤ c5GammaComplexNodeCore.1 := by
    rw [div_le_iff₀ hden]
    simpa [c5GammaComplexNodeCoreScaledReal] using hReLo
  have hqhiRe : c5GammaComplexNodeCore.1 ≤ ( + 16 : ℚ) / (2 : ℚ) ^ 1024 := by
    rw [le_div_iff₀ hden]
    have hh : c5GammaComplexNodeCore.1 * (2 : ℚ) ^ 1024 < ( + 16 : ℚ) := by
      simpa [c5GammaComplexNodeCoreScaledReal] using hReHi
    exact le_of_lt hh
  have hqloIm : (- : ℚ) / (2 : ℚ) ^ 1024 ≤ c5GammaComplexNodeCore.2 := by
    rw [div_le_iff₀ hden]
    simpa [c5GammaComplexNodeCoreScaledImag] using hImLo
  have hqhiIm : c5GammaComplexNodeCore.2 ≤ (- + 16 : ℚ) / (2 : ℚ) ^ 1024 := by
    rw [le_div_iff₀ hden]
    have hh : c5GammaComplexNodeCore.2 * (2 : ℚ) ^ 1024 < (- + 16 : ℚ) := by
      simpa [c5GammaComplexNodeCoreScaledImag] using hImHi
    exact le_of_lt hh
  simp only [ZetaLean.ComplexInterval.contains, ZetaLean.Interval.contains,
    c5GammaComplexNodeCoreBox, ratComplexToComplex]
  constructor
  · constructor
    · exact_mod_cast hqloRe
    · exact_mod_cast hqhiRe
  · constructor
    · exact_mod_cast hqloIm
    · exact_mod_cast hqhiIm

#print axioms c5GammaComplexNodeRealFloorSum_eq
#print axioms c5GammaComplexNodeImagFloorSum_eq
#print axioms c5GammaComplexNodeCoreBox_contains
