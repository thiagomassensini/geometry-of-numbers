import SigmaC5GammaCoreChunk64Probe
import Mathlib.Tactic

open SigmaC5Gamma
open scoped BigOperators

set_option maxHeartbeats 0
set_option maxRecDepth 1000000
set_option exponentiation.threshold 2048

private theorem c5GammaPow1024_nat : (2 : ℕ) ^ 1024 =  := by decide
private theorem c5GammaPow1024_rat : (2 : ℚ) ^ 1024 = ( : ℚ) := by
  exact_mod_cast c5GammaPow1024_nat

theorem c5GammaChunk64_0_floor : Int.floor (c5GammaCoreChunk64 0) = - := by
  rw [Int.floor_eq_iff]
  unfold c5GammaCoreChunk64
  rw [c5GammaPow1024_rat]
  norm_num (config := { maxSteps := 10000000 }) [ratGammaTerm, ratComplexInv, ratComplexMul, Finset.sum_apply, Finset.sum_range_succ]

