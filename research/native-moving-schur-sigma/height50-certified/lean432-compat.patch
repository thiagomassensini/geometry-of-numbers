@@ -4,0 +5 @@ public import Mathlib.NumberTheory.Harmonic.Bounds
+public import Mathlib.Analysis.SpecialFunctions.Integrals.Basic
@@ -268 +269,20 @@ lemma psi_le {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) (j : ℕ) : psi a b j
-  Real.arctan_le_self (xj_nonneg ha hab j)
+  by
+    have hx : 0 ≤ xj a b j := xj_nonneg ha hab j
+    have hden : Continuous (fun t : ℝ => 1 + t ^ 2) := by fun_prop
+    have hcont : Continuous (fun t : ℝ => (1 + t ^ 2)⁻¹) :=
+      hden.inv₀ (fun t => by positivity)
+    have hf : IntervalIntegrable (fun t : ℝ => (1 + t ^ 2)⁻¹) MeasureTheory.volume 0
+        (xj a b j) := hcont.intervalIntegrable 0 (xj a b j)
+    have hg : IntervalIntegrable (fun _t : ℝ => (1 : ℝ)) MeasureTheory.volume 0
+        (xj a b j) := continuous_const.intervalIntegrable 0 (xj a b j)
+    have hmono :
+        (∫ t in (0 : ℝ)..xj a b j, (1 + t ^ 2)⁻¹) ≤
+          ∫ _t in (0 : ℝ)..xj a b j, (1 : ℝ) := by
+      apply intervalIntegral.integral_mono_on hx hf hg
+      intro t ht
+      have hdenPos : 0 < 1 + t ^ 2 := by positivity
+      have hdenGe : 1 ≤ 1 + t ^ 2 := by nlinarith [sq_nonneg t]
+      exact (inv_le_one₀ hdenPos).2 hdenGe
+    rw [integral_inv_one_add_sq, Real.arctan_zero, sub_zero] at hmono
+    simp only [intervalIntegral.integral_const, sub_zero, smul_eq_mul, mul_one] at hmono
+    simpa [psi, xj] using hmono
