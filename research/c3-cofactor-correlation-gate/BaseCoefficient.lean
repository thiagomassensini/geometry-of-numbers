def normalizedPolynomialCoefficientQ (i : ℕ) : ℚ :=
  if i = 0 then 1 else if i = 2 then -4 else 0

def normalizedExponentialCoefficientQ (e : ℕ) : ℚ :=
  (-1 / 2 : ℚ) ^ e / (e.factorial : ℚ)

