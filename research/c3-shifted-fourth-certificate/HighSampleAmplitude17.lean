def tightHighSampleScaledLogBox (n : Fin 60) : Box :=
  bmul (Box.point (-1/2)) (tightHighSampleLogBox n)

theorem tight_high_sample_amplitude_evaluator_check (n : Fin 60) :
    (expBox (tightHighSampleScaledLogBox n)).Subset
      (tightHighSampleAmplitudeReference n) := by
  fin_cases n <;> decide +kernel

theorem tight_high_sample_amplitude_contains (n : Fin 60) :
    (tightHighSampleAmplitudeReference n).Contains
      (Real.exp (-Real.log (n.val+206:ℕ)/2)) := by
  let j : Fin 265 := ⟨n.val+205, by omega⟩
  have hlogEq : tightSampleLogBox j = tightHighSampleLogBox n := by
    simp [tightSampleLogBox, j]
  have hsrc : expBox (tightHighSampleScaledLogBox n) = tightSampleAmplitudeBox j := by
    simp only [tightSampleAmplitudeBox, tightSampleScaledLogBox,
      tightHighSampleScaledLogBox]
    rw [hlogEq]
  have haddr : j.val+1 = n.val+206 := by simp [j]
  have hbase := tight_sample_amplitude_contains j
  rw [haddr] at hbase
  apply Box.subset_contains (tight_high_sample_amplitude_evaluator_check n)
  rw [hsrc]
  exact hbase

end
