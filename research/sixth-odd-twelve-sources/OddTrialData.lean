def trialPairingBox (i j : ℕ) : Box :=
  if hi : i < 6 then if hj : j < 6 then trialPairingTable ⟨i,hi⟩ ⟨j,hj⟩ else .all else .all

theorem trial_pairing_checks : ∀ i j : Fin 6,
    (rawTrialPairingBox i.val j.val).contained (trialPairingBox i.val j.val) = true := by
  decide +kernel

theorem trial_upper_check : ∀ i j : Fin 6,
    j < i → trialCoefficient i.val j.val = 0 := by
  decide +kernel

theorem trial_diagonal_check : ∀ i : Fin 6, 0 < trialCoefficient i.val i.val := by
  decide +kernel

end CarrySixthOdd
