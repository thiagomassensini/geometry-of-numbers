def trialCoefficient (i j : ℕ) : ℚ :=
  if hi : i < 6 then if hj : j < 6 then trialCoefficientData ⟨i,hi⟩ ⟨j,hj⟩ else 0 else 0

noncomputable def trialMatrix : Matrix (Fin 6) (Fin 6) ℝ :=
  fun i j => (trialCoefficient i.val j.val:ℝ)

noncomputable def trialPairing (i j : ℕ) : ℝ :=
  ∑ a ∈ Finset.range 6, ∑ b ∈ Finset.range 6,
    (trialCoefficient a i:ℝ)*h (a+b+1)*(trialCoefficient b j:ℝ)

def rawTrialPairingBox (i j : ℕ) : Box :=
  Box.sum (fun a => Box.sum (fun b =>
    ((Box.ofRat (trialCoefficient a i)).mul (compactMomentBox (a+b+1))).mul
      (Box.ofRat (trialCoefficient b j))) 6) 6

