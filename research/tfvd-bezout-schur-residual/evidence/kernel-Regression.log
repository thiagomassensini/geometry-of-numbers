CarrySourceBezout.sourceDirection_transport (c h : ℕ → ℝ) (hc : c 0 ≠ 0) (s n : ℕ) :
  (convolutionMatrix c (n + 1)).transpose.mulVec (sourceDirection c h s n) = criticalVector h s n
CarrySourceBezout.monicSourceDirection_eq_sourceCritical (c h : ℕ → ℝ) (hc : c 0 ≠ 0) (hr : SourceRecurrence c h)
  (b : Bool) (n : ℕ) (hA : IsUnit (sourceMomentMatrix h (if b = true then 1 else 0) n)) :
  monicSourceDirection c h (if b = true then 1 else 0) n = sourceCritical c b n
CarrySourceBezout.sourceDirection_energy (c h : ℕ → ℝ) (hc : c 0 ≠ 0) (hr : SourceRecurrence c h) (b : Bool) (n : ℕ)
  (hA : IsUnit (sourceMomentMatrix h (if b = true then 1 else 0) n)) :
  matrixPair (coefficientBlock (sourceKernel c b) (n + 1)) (sourceDirection c h (if b = true then 1 else 0) n)
      (sourceDirection c h (if b = true then 1 else 0) n) =
    sourceMomentSchur h (if b = true then 1 else 0) n
CarrySourceBezout.monicSourceDirection_energy (c h : ℕ → ℝ) (hc : c 0 ≠ 0) (hr : SourceRecurrence c h) (b : Bool)
  (n : ℕ) (hA : IsUnit (sourceMomentMatrix h (if b = true then 1 else 0) n)) :
  matrixPair (coefficientBlock (sourceKernel c b) (n + 1)) (monicSourceDirection c h (if b = true then 1 else 0) n)
      (monicSourceDirection c h (if b = true then 1 else 0) n) =
    c 0 ^ 2 * sourceMomentSchur h (if b = true then 1 else 0) n
CarrySourceBezout.native_residual_literal_four_terms (M P : ℕ) (b : Bool) (n : ℕ)
  (hA : IsUnit (sourceMomentMatrix nativeH (if b = true then 1 else 0) n)) :
  literalResidualTerm M P true true b n + literalResidualTerm M P true false b n +
        literalResidualTerm M P false true b n +
      literalResidualTerm M P false false b n =
    ↑(nativeC 0 * nativeSourceSchurRemainder (if b = true then 1 else 0) n)
CarrySourceBezout.NativeTrace.stateTrace_head_tail (M : ℕ) (z : ℂ) :
  canonicalC3BracketTfvdCompletedTracePair M z = NativeTrace.headTrace M z + NativeTrace.tailTrace M z
CarrySourceBezout.literal_head_companion (M : ℕ) (w : ℂ)
  (hs : operatorHeightParameter w ∈ CPFormal.Analytic.Cp.genuineCriticalStrip) :
  (NativeTrace.headTrace M w).2 = -deriv (fun z => (NativeTrace.headTrace M z).1) w
CarrySourceBezout.literal_tail_companion (M : ℕ) (w : ℂ)
  (hs : operatorHeightParameter w ∈ CPFormal.Analytic.Cp.genuineCriticalStrip) :
  (NativeTrace.tailTrace M w).2 = -deriv (fun z => (NativeTrace.tailTrace M z).1) w
CarrySourceBezout.literal_tail_jet_envelope : ∃ C, 0 < C ∧ ∀ (M n : ℕ), ‖literalTail M n‖ ≤ C / (↑M + 1) * 16 ^ n
CarrySourceBezout.literal_error_budget_tendsto_zero (b : Bool) (r : ℕ) (x y : Fin r → ℝ) :
  Filter.Tendsto (fun M => literalErrorBudget M M b r x y) Filter.atTop (nhds 0)
CarrySourceBezout.native_residual_repartition (M P : ℕ) (U V : ℕ → ℂ) (b : Bool) (n : ℕ)
  (hA : IsUnit (sourceMomentMatrix nativeH (if b = true then 1 else 0) n)) :
  have z := monicSourceDirection nativeC nativeH (if b = true then 1 else 0) n;
  coefficientPair (literalHead M + U) (literalHead P + V) b (n + 1) z z +
          coefficientPair (literalHead M + U) (literalTail P - V) b (n + 1) z z +
        coefficientPair (literalTail M - U) (literalHead P + V) b (n + 1) z z +
      coefficientPair (literalTail M - U) (literalTail P - V) b (n + 1) z z =
    ↑(nativeC 0 * nativeSourceSchurRemainder (if b = true then 1 else 0) n)
CarrySourceBezout.negative_control_not_posSemidef :
  ¬(coefficientBlock (sourceKernel negativeControl false) 2).PosSemidef
CarrySourceBezout.literal_head_response_odd (M n : ℕ) :
  responseCoefficient (literalHead M) true n =
    1 / 2 * NativeTrace.sourceJet (2 * n + 1) fun w => (NativeTrace.headTrace M w).2
CarrySourceBezout.literal_tail_response_even_succ (M n : ℕ) :
  responseCoefficient (literalTail M) false (n + 1) =
    1 / 2 * NativeTrace.sourceJet (2 * n + 1) fun w => (NativeTrace.tailTrace M w).2
