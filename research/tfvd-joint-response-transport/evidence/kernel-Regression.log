CarryTfvdJoint.critical_jointKernel_tendsto (s : Fin 2) (n : ℕ)
  (hA : IsUnit (sourceMomentMatrix CarryCriticalSource.h (↑s) n)) (cutoff : ℕ → ℕ) :
  Filter.Tendsto
    (fun k =>
      (∑ i,
          ∑ j,
            (starRingEnd ℂ)
                  (CarryTfvdCritical.fixedMaterial (n + 1) k (CarryCriticalSource.criticalCoordinates s n) i) *
                CarryTfvdCritical.fixedMaterial (n + 1) k (CarryCriticalSource.criticalCoordinates s n) j *
              jointKernel (cutoff k) (cutoff k) k ↑i ↑j).re)
    Filter.atTop (nhds (sourceMomentSchur CarryCriticalSource.h (↑s) n))
