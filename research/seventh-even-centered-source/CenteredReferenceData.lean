def refC (n : ℕ) : ℚ := if h : n < 14 then referenceCoefficients ⟨n,h⟩ else 0

def refH (n : ℕ) : ℚ := if h : n < 13 then referenceMoments ⟨n,h⟩ else 0

def derivC (n j : ℕ) : ℚ := if hn : n < 13 then
  if hj : j < 14 then derivativeCoefficients ⟨n,hn⟩ ⟨j,hj⟩ else 0 else 0

def indicator (j i : ℕ) : ℚ := if j=i then 1 else 0

theorem reference_recurrence_check : ∀ n : Fin 13,
    refC 0*refH n.val = -(n.val+1:ℚ)*refC (n.val+1)-
      ∑ k ∈ Finset.range n.val, refH k*refC (n.val-k) := by
  decide +kernel

theorem derivative_recurrence_check : ∀ n : Fin 13, ∀ j : Fin 14,
    refC 0*derivC n.val j.val = -(n.val+1:ℚ)*indicator j.val (n.val+1)-
      (∑ k ∈ Finset.range n.val, derivC k j.val*refC (n.val-k))-
      ∑ k ∈ Finset.range (n.val+1), refH k*indicator j.val (n.val-k) := by
  decide +kernel

end CarrySeventhEven
