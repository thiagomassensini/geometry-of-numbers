def compactMomentBox (n : ℕ) : Box := if h : n < 13 then compactMomentTable ⟨n,h⟩ else .all

theorem compact_moment_checks : ∀ n : Fin 13,
    (centeredMomentBox n.val).contained (compactMomentBox n.val) = true := by
  decide +kernel

theorem mem_compactMomentBox (n : ℕ) : (compactMomentBox n).Mem (h n) := by
  by_cases hn : n < 13
  · exact mem_of_contained (mem_centeredMomentBox n hn) (compact_moment_checks ⟨n,hn⟩)
  · simp only [compactMomentBox,dif_neg hn,Box.Mem]

end CarrySeventhEven
