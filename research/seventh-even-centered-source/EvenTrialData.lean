theorem trial_pairing_checks : ∀ i j : Fin 7,
    (rawTrialPairingBox i.val j.val).contained (trialPairingBox i.val j.val) = true := by
  decide +kernel

theorem trial_upper_check : ∀ i j : Fin 7, j < i → trialCoefficient i.val j.val = 0 := by
  decide +kernel

theorem trial_diagonal_check : ∀ i : Fin 7, 0 < trialCoefficient i.val i.val := by
  decide +kernel

