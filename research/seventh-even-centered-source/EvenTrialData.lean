def trialCoefficient (i j : ℕ) : ℚ :=
  if hi : i < 7 then if hj : j < 7 then trialCoefficientData ⟨i,hi⟩ ⟨j,hj⟩ else 0 else 0

noncomputable def trialMatrix : Matrix (Fin 7) (Fin 7) ℝ := fun i j => (trialCoefficient i.val j.val:ℝ)

noncomputable def trialPairing (i j : ℕ) : ℝ :=
  ∑ a ∈ Finset.range 7, ∑ b ∈ Finset.range 7,
    (trialCoefficient a i:ℝ)*h (a+b)*(trialCoefficient b j:ℝ)

def rawTrialPairingBox (i j : ℕ) : Box :=
  Box.sum (fun a => Box.sum (fun b =>
    ((Box.ofRat (trialCoefficient a i)).mul (compactMomentBox (a+b))).mul
      (Box.ofRat (trialCoefficient b j))) 7) 7

