import GeometryOfNumbers.Analysis.CarryMaterialProjectiveChiralSewing
import GeometryOfNumbers.Analysis.CompletedMaterialGradientStrongClock
import Mathlib.Tactic

/-!
# C2 physical source at complex height (pre-Cauchy–Pick)

Build the complex-height completed material carrier from exactly the original
material legs, preserving the unit seed, ℓ² interior, and ℓ¹-derived full
cell return. The complex function is NOT generated by a target Pick kernel,
xi coefficients, or Cauchy factorization.

The source is shown to restrict *literally* to the existing real-height
completed physical C2 state. Only local holomorphicity is claimed, where
the genuine ℓ¹/ℓ² convergence controls already exist.
-/

namespace GeometryOfNumbers.Analysis

open BaseTwoCompletion
open scoped BigOperators InnerProductSpace

noncomputable section
set_option autoImplicit false

/-- Same actual material first differences in ℓ¹, now at complex height. -/
def carryMaterialComplexGradientL1 (z : ℂ) : MaterialGradientL1 :=
  baseTwoComplexMaterialGradientLp 1 z

/-- Same actual material first differences in ℓ², now at complex height. -/
def carryMaterialComplexGradientL2 (z : ℂ) : MaterialEdgeL2 :=
  baseTwoComplexMaterialGradientLp 2 z

/-- Derived cell return; this is calculated by the old bounded ℓ¹
undressed readout, not by subtracting a prescribed completed xi. -/
def carryMaterialComplexReturn (z : ℂ) : ℂ :=
  baseTwoCompletedUndressedReadout (1, carryMaterialComplexGradientL1 z) - 1

/-- Material source on a complex height, keeping all three physical roles. -/
def carryMaterialComplexState (z : ℂ) : MaterialCarrier :=
  WithLp.toLp 2 (1,
    WithLp.toLp 2 (carryMaterialComplexGradientL2 z, carryMaterialComplexReturn z))

theorem carryMaterialComplexGradientL1_ofReal (t : ℝ) :
    carryMaterialComplexGradientL1 (t : ℂ) =
      baseTwoCompletedMaterialGradient t := by
  exact baseTwoComplexMaterialGradientLp_ofReal 1 (by norm_num) t
    (baseTwoCompletedMaterialGradient t) (by intro j; rfl)

theorem carryMaterialComplexGradientL2_ofReal (t : ℝ) :
    carryMaterialComplexGradientL2 (t : ℂ) =
      baseTwoCompletedMaterialGradientL2 t := by
  exact baseTwoComplexMaterialGradientLp_ofReal 2 (by norm_num) t
    (baseTwoCompletedMaterialGradientL2 t) (by intro j; rfl)

theorem carryMaterialComplexReturn_ofReal (t : ℝ) :
    carryMaterialComplexReturn (t : ℂ) = baseTwoCompletedBoundaryValue t := by
  rw [carryMaterialComplexReturn, carryMaterialComplexGradientL1_ofReal]
  have h := baseTwoCompletedBoundaryValue_eq_readout_sub_seed t
  rw [baseTwoCompletedUndressedState, criticalMaterialSample_one] at h
  exact h.symm

/-- A true real-axis reconstruction, including the ORIGINAL return. -/
theorem carryMaterialComplexState_ofReal (t : ℝ) :
    carryMaterialComplexState (t : ℂ) =
      baseTwoCompletedBoundaryHilbertState t := by
  simp [carryMaterialComplexState, baseTwoCompletedBoundaryHilbertState,
    carryMaterialComplexGradientL2_ofReal, carryMaterialComplexReturn_ofReal]

/-- The physical complex state has the same original seed+return readout,
without assuming it is the native completed characteristic. -/
theorem carryMaterialComplexState_readout (z : ℂ) :
    baseTwoCompletedBoundaryHilbertReadout (carryMaterialComplexState z) =
      baseTwoCompletedUndressedReadout (1, carryMaterialComplexGradientL1 z) := by
  simp [carryMaterialComplexState, carryMaterialComplexReturn,
    baseTwoCompletedBoundaryHilbertReadout_apply]

theorem carryMaterialComplexState_readout_ofReal (t : ℝ) :
    baseTwoCompletedBoundaryHilbertReadout
        (carryMaterialComplexState (t : ℂ)) =
      baseTwoCriticalCompleteSignal t := by
  rw [carryMaterialComplexState_ofReal, baseTwoCompletedBoundaryHilbertReadout_eq_signal]

/-- Local holomorphicity of the *material* return, using strong ℓ¹ convergence. -/
theorem carryMaterialComplexReturn_differentiableOn_ball (t : ℝ) :
    DifferentiableOn ℂ carryMaterialComplexReturn
      (Metric.ball (t : ℂ) (1/4 : ℝ)) := by
  unfold carryMaterialComplexReturn
  have hG := baseTwoComplexMaterialGradientLp_differentiableOn_ball 1 t
  have hpair : DifferentiableOn ℂ
      (fun z : ℂ => ((1 : ℂ), baseTwoComplexMaterialGradientLp 1 z)) (Metric.ball (t : ℂ) (1/4 : ℝ)) :=
    (differentiableOn_const (c := (1 : ℂ))).prodMk hG
  exact ((baseTwoCompletedUndressedReadout.differentiable.comp_differentiableOn hpair).sub
    (differentiableOn_const 1))

/-- The interior keeps its own strong holomorphicity in the actual ℓ² norm. -/
theorem carryMaterialComplexGradientL2_differentiableOn_ball (t : ℝ) :
    DifferentiableOn ℂ carryMaterialComplexGradientL2
      (Metric.ball (t : ℂ) (1/4 : ℝ)) :=
  baseTwoComplexMaterialGradientLp_differentiableOn_ball 2 t



/-- Both actual physical Hilbert coordinates depend holomorphically on
complex height in the proven quarter-ball of ℓ¹ and ℓ² convergence. -/
theorem carryMaterialComplexState_differentiableOn_ball (t : ℝ) :
    DifferentiableOn ℂ carryMaterialComplexState
      (Metric.ball (t : ℂ) (1/4 : ℝ)) := by
  have hinnerPair : DifferentiableOn ℂ
      (fun z : ℂ => (carryMaterialComplexGradientL2 z, carryMaterialComplexReturn z))
      (Metric.ball (t : ℂ) (1/4 : ℝ)) :=
    (carryMaterialComplexGradientL2_differentiableOn_ball t).prodMk
      (carryMaterialComplexReturn_differentiableOn_ball t)
  have hinner : DifferentiableOn ℂ
      (fun z : ℂ => WithLp.toLp 2
        (carryMaterialComplexGradientL2 z, carryMaterialComplexReturn z))
      (Metric.ball (t : ℂ) (1/4 : ℝ)) := by
    have hlin := (WithLp.prodContinuousLinearEquiv 2 ℂ MaterialEdgeL2 ℂ).symm.differentiable
    exact hlin.comp_differentiableOn hinnerPair
  have houterPair : DifferentiableOn ℂ
      (fun z : ℂ => ((1 : ℂ),
         WithLp.toLp 2 (carryMaterialComplexGradientL2 z, carryMaterialComplexReturn z)))
      (Metric.ball (t : ℂ) (1/4 : ℝ)) :=
    (differentiableOn_const (c := (1 : ℂ))).prodMk hinner
  unfold carryMaterialComplexState
  have hlin := (WithLp.prodContinuousLinearEquiv 2 ℂ ℂ
      (WithLp 2 (MaterialEdgeL2 × ℂ))).symm.differentiable
  exact hlin.comp_differentiableOn houterPair

/-- The actual physical complex state has a genuine complex derivative at
every real time; the companion can therefore be computed from this source. -/
theorem carryMaterialComplexState_differentiableAt_ofReal (t : ℝ) :
    DifferentiableAt ℂ carryMaterialComplexState (t : ℂ) :=
  (carryMaterialComplexState_differentiableOn_ball t).differentiableAt
    (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self (by norm_num)))

end
end GeometryOfNumbers.Analysis

#print axioms GeometryOfNumbers.Analysis.carryMaterialComplexState_ofReal
#print axioms GeometryOfNumbers.Analysis.carryMaterialComplexReturn_differentiableOn_ball
#print axioms GeometryOfNumbers.Analysis.carryMaterialComplexState_differentiableAt_ofReal
